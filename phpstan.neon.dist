includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    # Declarations only, never autoloaded and never shipped. The plugin must
    # genuinely implement LibreNMS\Interfaces\UI\DeviceTab -- PageTabs::getTab()
    # is typed against it -- and interface.notFound cannot be suppressed with
    # ignoreErrors the way class.notFound can.
    scanFiles:
        - tools/stubs/librenms-core.php
    excludePaths:
        analyse:
            # Generated from protocol/protocol.json; the protocol-drift CI job
            # guards this file, not static analysis.
            - src/Protocol.php
    ignoreErrors:
        # LibreNMS core classes are absent when analysing standalone. Hooks name
        # App\Models\Device only in docblocks; src/Librenms is the only place
        # allowed to reference core, and tests/Contract asserts those symbols
        # still exist against a real checkout.
        -
            identifier: class.notFound
            path: tests/Contract/*
        # Pest rebinds $this inside test closures to the configured TestCase
        # (ours extends Orchestra\Testbench\TestCase), which static analysis
        # cannot see. Only the Laravel testing helpers are ignored, so a genuine
        # typo in a method name is still caught.
        -
            message: '#Call to an undefined method PHPUnit\\Framework\\TestCase::(artisan|assertDatabase\w+|withoutExceptionHandling|actingAs|beforeApplicationDestroyed)\(\)#'
            path: tests/*
        -
            message: '#Access to an undefined property PHPUnit\\Framework\\TestCase::\$app#'
            path: tests/*
        # The plugin's view namespace is registered at runtime by
        # loadViewsFrom(), so larastan's view finder cannot resolve
        # "WebTerm::admin" while analysing. This records an analysis blind spot
        # rather than suppressing a defect: AdminConsoleTest renders the view
        # for real and asserts on what it does and does not contain, so a broken
        # view name fails the suite.
        -
            message: '#expects view-string\|null, string given#'
            paths:
                - src/Http/Controllers/*
                - tests/*
