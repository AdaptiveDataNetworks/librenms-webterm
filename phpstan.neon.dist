includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            # Generated from protocol/protocol.json; the protocol-drift CI job
            # guards this file, not static analysis.
            - src/Protocol.php
    ignoreErrors:
        # LibreNMS core classes are absent when analysing standalone. Hooks name
        # App\Models\Device only in docblocks; src/Librenms is the only place
        # allowed to reference core, and tests/Contract asserts those symbols
        # still exist against a real checkout.
        -
            identifier: class.notFound
            path: src/Hooks/*
        -
            identifier: class.notFound
            path: tests/Contract/*
        # Pest rebinds $this inside test closures to the configured TestCase
        # (ours extends Orchestra\Testbench\TestCase), which static analysis
        # cannot see. Only the Laravel testing helpers are ignored, so a genuine
        # typo in a method name is still caught.
        -
            message: '#Call to an undefined method PHPUnit\\Framework\\TestCase::(artisan|assertDatabase\w+|withoutExceptionHandling)\(\)#'
            path: tests/*
