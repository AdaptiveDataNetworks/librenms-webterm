# LibreNMS WebTerm gateway configuration.
#
# The shared secret is NOT set here. It is read from a file, because
# environment variables are visible in /proc, in `systemctl show`, and in any
# crash dump or support bundle. See WEBTERM_SECRET_FILE below.

# Control plane. Loopback only: it has no transport security, and anything that
# can reach this port can create a session. Put it behind the LibreNMS proxy.
WEBTERM_LISTEN=127.0.0.1:8377
WEBTERM_METRICS_LISTEN=127.0.0.1:8378

# Path to the 32-byte shared secret, generated by:
#   librenms-webterm-gw init
# LibreNMS must read the same file.
WEBTERM_SECRET_FILE=/etc/librenms-webterm/gateway.secret

# Browser origins permitted to open a terminal. REQUIRED: with none set, every
# connection is refused. Use the exact origin your browser shows.
# WEBTERM_ALLOWED_ORIGINS=https://librenms.example.com

WEBTERM_LOG_LEVEL=info
WEBTERM_MAX_SESSIONS=100
