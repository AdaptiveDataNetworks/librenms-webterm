{
  "$comment": "SOURCE OF TRUTH for the WebTerm wire protocol. src/Protocol.php and gateway/internal/proto/proto.go are GENERATED from this file by tools/generate-protocol.php. Never edit the generated files; CI asserts `git diff --exit-code` after regenerating.",
  "name": "lnms-webterm",
  "version": 1,
  "subprotocol": "lnms-webterm.v1",
  "min_supported_version": 1,
  "max_supported_version": 1,
  "control_plane": {
    "default_listen": "127.0.0.1:8377",
    "default_metrics_listen": "127.0.0.1:8378",
    "secret_bytes": 32,
    "hkdf_hash": "sha256",
    "hkdf_salt": "lnms-webterm/v1",
    "hkdf_info_control": "control",
    "signature_prefix": "v1=",
    "timestamp_skew_seconds": 30,
    "nonce_cache_seconds": 120,
    "headers": {
      "timestamp": "X-WebTerm-Timestamp",
      "nonce": "X-WebTerm-Nonce",
      "signature": "X-WebTerm-Signature",
      "reject_reason": "X-WebTerm-Reject"
    },
    "endpoints": {
      "hello": {
        "method": "GET",
        "path": "/api/v1/hello"
      },
      "session_create": {
        "method": "POST",
        "path": "/api/v1/sessions"
      },
      "hostkey_scan": {
        "method": "POST",
        "path": "/api/v1/hostkey/scan"
      },
      "session_credential": {
        "method": "POST",
        "path": "/api/v1/sessions/{id}/credential"
      },
      "session_list": {
        "method": "GET",
        "path": "/api/v1/sessions"
      },
      "session_delete": {
        "method": "DELETE",
        "path": "/api/v1/sessions/{id}"
      },
      "session_notice": {
        "method": "POST",
        "path": "/api/v1/sessions/{id}/notice"
      },
      "healthz": {
        "method": "GET",
        "path": "/healthz"
      },
      "readyz": {
        "method": "GET",
        "path": "/readyz"
      }
    },
    "proxied_paths": [
      "/ws",
      "/ui/"
    ]
  },
  "ticket": {
    "bytes": 32,
    "encoding": "base64url_unpadded",
    "ttl_seconds": 30,
    "single_use": true,
    "transport": "first_websocket_frame",
    "$comment": "Never a query parameter: query strings are written to nginx access logs and leak via Referer."
  },
  "auth_methods": [
    "signed_certificate",
    "password",
    "private_key"
  ],
  "key_algorithms": [
    "ed25519",
    "ecdsa-p256",
    "rsa-4096"
  ],
  "host_key_policies": [
    "pin",
    "tofu_first_connect"
  ],
  "algorithm_profiles": [
    "modern",
    "legacy"
  ],
  "frames": {
    "client": {
      "auth": {
        "fields": [
          "ticket",
          "cols",
          "rows"
        ]
      },
      "data": {
        "fields": [
          "data"
        ]
      },
      "resize": {
        "fields": [
          "cols",
          "rows"
        ]
      },
      "ping": {
        "fields": []
      }
    },
    "server": {
      "ready": {
        "fields": [
          "session_id",
          "server_version"
        ]
      },
      "data": {
        "fields": [
          "data"
        ]
      },
      "notice": {
        "fields": [
          "level",
          "message"
        ]
      },
      "error": {
        "fields": [
          "code",
          "message"
        ]
      },
      "pong": {
        "fields": []
      }
    }
  },
  "close_codes": {
    "4400": "protocol_error",
    "4401": "ticket_invalid_or_expired",
    "4403": "authorization_revoked",
    "4408": "idle_timeout",
    "4409": "session_superseded",
    "4413": "output_buffer_overrun",
    "4429": "concurrency_limit",
    "4500": "gateway_internal_error",
    "4502": "upstream_rejected",
    "4503": "upstream_unreachable"
  },
  "limits": {
    "max_output_buffer_bytes": 262144,
    "max_frame_bytes": 65536,
    "ws_ping_interval_seconds": 20,
    "ws_pong_timeout_seconds": 60,
    "$comment": "ws_ping_interval must stay well under nginx proxy_read_timeout, whose default of 60s otherwise kills idle terminals."
  }
}
